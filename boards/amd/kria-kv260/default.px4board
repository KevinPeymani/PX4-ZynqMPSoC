CONFIG_BOARD_TOOLCHAIN="arm-none-eabi"
CONFIG_BOARD_ARCHITECTURE="cortex-r5"
CONFIG_BOARD_CONSTRAINED_FLASH=y

# Serial port assignments
# UART0 (0xFF000000) is NSH console and TEL1.
# UART1 (0xFF010000) is available for Linux side.
CONFIG_BOARD_SERIAL_TEL1="/dev/ttyS0"

# Minimal system commands for NSH testing
CONFIG_SYSTEMCMDS_PARAM=y
CONFIG_SYSTEMCMDS_VER=y
CONFIG_SYSTEMCMDS_UORB=y
CONFIG_SYSTEMCMDS_WORK_QUEUE=y
CONFIG_SYSTEMCMDS_NSHTERM=y
CONFIG_SYSTEMCMDS_SYSTEM_TIME=y

# SIH (simulation-in-hardware) minimal set
CONFIG_MODULES_SIMULATION_SIMULATOR_SIH=y
CONFIG_MODULES_CONTROL_ALLOCATOR=y
CONFIG_MODULES_SENSORS=y

# State estimation
CONFIG_MODULES_EKF2=y

# Vehicle state management
# commander's failsafe.h references px4::params::GF_ACTION, which is only
# defined by navigator's geofence_params.yaml — commander will not compile
# without navigator (or at least its params) present, so bring both in
# together. No SD card/filesystem on this board: dataman uses the RAM
# backend (DATAMAN_PERSISTENT_STORAGE unset), same approach as the
# espressif/esp32 board.
CONFIG_MODULES_COMMANDER=y
CONFIG_MODULES_NAVIGATOR=y
# CONFIG_NAVIGATOR_ADSB is not set
CONFIG_MODULES_DATAMAN=y
# CONFIG_DATAMAN_PERSISTENT_STORAGE is not set
CONFIG_NUM_MISSION_ITMES_SUPPORTED=50
CONFIG_MODULES_LAND_DETECTOR=y
