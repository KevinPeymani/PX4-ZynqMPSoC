CONFIG_BOARD_TOOLCHAIN="arm-none-eabi"
CONFIG_BOARD_ARCHITECTURE="cortex-r5"
# CONSTRAINED_FLASH is deliberately NOT set.  It gates more than its name
# suggests: cmake/kconfig.cmake excludes parameters.json.xz,
# events/all_events.json.xz and actuators.json.xz from ROMFS when it is on,
# which flips component_general.json's metadata URIs from mftp://etc/extras/
# to an S3 URL for a board PX4's CI has never published.  QGroundControl then
# cannot load the events metadata, so EventHandler::healthAndArmingChecksSupported()
# returns false, it falls back to guessing readiness from SYS_STATUS, and it
# hides the Arming Check Report entirely -- i.e. it stops telling you which
# preflight check is failing, which is exactly the information needed here.
# The three files total ~68 KB against a 22 MB DDR-resident image, so there is
# nothing constrained about this target's flash.

# Serial port assignments
# UART0 (0xFF000000) is NSH console — electrically dead on this carrier
# (no MIO pins assigned), so TEL1 is mapped to the rpmsg-uart transport
# (/dev/ttyRPMSG0, registered by uart_rpmsg_init() in board_app_initialize())
# instead of a physical UART. UART1 (0xFF010000) is Linux's own console.
CONFIG_BOARD_SERIAL_TEL1="/dev/ttyRPMSG0"

# MAVLink over the rpmsg-uart transport above. Needs CONFIG_PIPES, set in
# nuttx-config/nsh/defconfig (raw NuttX Kconfig options here are silently
# ignored — this file only understands PX4's own CONFIG_MODULES_*/
# CONFIG_BOARD_* wrappers).
CONFIG_MODULES_MAVLINK=y

# Minimal system commands for NSH testing
CONFIG_SYSTEMCMDS_PARAM=y
CONFIG_SYSTEMCMDS_VER=y
CONFIG_SYSTEMCMDS_UORB=y
CONFIG_SYSTEMCMDS_WORK_QUEUE=y
CONFIG_SYSTEMCMDS_NSHTERM=y
CONFIG_SYSTEMCMDS_SYSTEM_TIME=y

# SIH (simulation-in-hardware) minimal set
CONFIG_MODULES_SIMULATION_SIMULATOR_SIH=y
CONFIG_MODULES_CONTROL_ALLOCATOR=y
CONFIG_MODULES_SENSORS=y

# State estimation
CONFIG_MODULES_EKF2=y

# Vehicle state management
# commander's failsafe.h references px4::params::GF_ACTION, which is only
# defined by navigator's geofence_params.yaml — commander will not compile
# without navigator (or at least its params) present, so bring both in
# together. No SD card/filesystem on this board: dataman uses the RAM
# backend (DATAMAN_PERSISTENT_STORAGE unset), same approach as the
# espressif/esp32 board.
CONFIG_MODULES_COMMANDER=y
CONFIG_MODULES_NAVIGATOR=y
# CONFIG_NAVIGATOR_ADSB is not set
CONFIG_MODULES_DATAMAN=y
# CONFIG_DATAMAN_PERSISTENT_STORAGE is not set
CONFIG_NUM_MISSION_ITMES_SUPPORTED=50
CONFIG_MODULES_LAND_DETECTOR=y

# Multicopter control stack + pilot input.
#
# Required by the SYS_AUTOSTART=1100 (SIH Quadcopter X) airframe set in
# init/rc.board_defaults: rcS dispatches on VEHICLE_TYPE to rc.mc_apps, which
# starts control_allocator, mc_rate_control, mc_att_control,
# mc_hover_thrust_estimator, flight_mode_manager, mc_pos_control and
# land_detector.  rcS's common section additionally starts rc_update and
# manual_control.
#
# These are not optional extras on this board -- they are why QGroundControl
# reported parameters "missing from firmware".  PX4 only publishes parameters
# that something has actually param_find()-ed, so a module that never starts
# has no parameters at all from the GCS's point of view.  Without an airframe
# and without these modules, RC_MAP_* (rc_update), COM_FLTMODE1-6
# (manual_control), RTL_*/MIS_* (navigator), CA_* (control_allocator),
# LNDMC_* (land_detector) and MPC_* (mc_pos_control) were all absent, and QGC
# names whichever of those happen to be on its own required list.
CONFIG_MODULES_RC_UPDATE=y
CONFIG_MODULES_MANUAL_CONTROL=y
CONFIG_MODULES_MC_RATE_CONTROL=y
CONFIG_MODULES_MC_ATT_CONTROL=y
CONFIG_MODULES_MC_POS_CONTROL=y
CONFIG_MODULES_MC_HOVER_THRUST_ESTIMATOR=y
CONFIG_MODULES_FLIGHT_MODE_MANAGER=y
