#!/bin/sh
#
# AMD Kria KV260 R5F — board-specific parameter defaults
#
# These are applied once at first boot (or after param reset).
# Battery ADC is not connected on the R5F side; set divisors to zero
# so the battery estimator doesn't generate bogus voltage readings.
#
# There is no battery ADC on the R5 side at all.  BAT1_SOURCE -1 says that
# honestly, and it is also the only value QGroundControl's PowerComponent
# accepts as "setup complete" without BAT1_N_CELLS/V_CHARGED/V_EMPTY being set.
# The divisors this replaces were harmless but meaningless -- PX4's own power
# and battery checks already early-return here, on CBRK_SUPPLY_CHK and on
# hil_state == HIL_STATE_ON, and MODULES_BATTERY_STATUS is not even built.
param set-default BAT1_SOURCE -1

# No RC receiver exists on this board.  QGC's radio setup page is only
# considered complete when RC_MAP_ROLL/PITCH/YAW/THROTTLE are mapped *or*
# COM_RC_IN_MODE is exactly 1 -- it hard-codes 1, so 4 ("stick input disabled")
# does not satisfy it and is strictly worse.  1 also makes rcCalibrationCheck
# early-return and still accepts MANUAL_CONTROL from QGC's virtual joystick.
# SITL already sets this for itself; SIH-on-real-hardware does not, which is
# why every "it just works in SIH" report comes from SITL.
#
# Note this does NOT make manual modes armable: modeCheck.cpp clears the
# arming bits for every mode requiring manual control regardless of
# COM_RC_IN_MODE -- that parameter only changes the reported severity.
# Autonomous modes (takeoff/mission/loiter) can arm without it.
param set-default COM_RC_IN_MODE 1

# Recommended by PX4's SIH documentation for estimator performance.
param set-default SENS_GPS0_DELAY 0

# Airframe: SIH Quadcopter X (ROMFS/px4fmu_common/init.d/airframes/
# 1100_rc_quad_x_sih.hil).  Without this, SYS_AUTOSTART is unset, rcS logs
# "ERROR [init] No airframe file found for SYS_AUTOSTART value", leaves
# VEHICLE_TYPE=none, and therefore never reaches the vehicle-type dispatch
# that runs rc.mc_apps -- so none of the flight-stack modules start.  The
# visible symptom is QGroundControl reporting parameters "missing from
# firmware" (RC_MAP_*, COM_FLTMODE*, RTL_*, ...), because PX4 only publishes
# parameters that a running module has param_find()-ed.
#
# 1100 matches what this board actually simulates: the airframe file sets
# SYS_HITL 2 (start SIH, skip real sensor startup), SIH_VEHICLE_TYPE 0 and the
# CA_ROTOR* geometry for a quad X.  It also sets CBRK_SUPPLY_CHK to allow
# arming with no real battery, which this board needs since the R5F has no
# battery ADC (see the BAT1 divisors above).
param set-default SYS_AUTOSTART 1100

# No SD card / filesystem on this board: dataman missions live in RAM.
param set-default SYS_DM_BACKEND 1

# simulator_sih is deliberately NOT started here.
#
# rcS starts it itself, later, from the SYS_HITL == 2 branch that the airframe
# above selects ("start the simulator in hardware if needed").  This file is
# sourced from rcS well before that -- before the airframe has even been loaded
# -- so starting sih here would put a 200 Hz simulation loop at priority 180 on
# the single R5 core while rcS still has hundreds of lines of parameter work to
# do.  Everything rcS spawns for a builtin runs at priority 100 and is
# waitpid()-ed, so it loses to sih every time; that is what made rcS stall
# partway through boot and never reach commander.
#
# Two earlier starts (this one and a direct simulator_sih_main() call in
# src/init.c) were both removed on 2026-07-30.  Their only visible trace was
# "ERROR [module] Task already running" logged at rcS's own sih line.
