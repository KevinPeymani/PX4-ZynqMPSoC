#
# NuttX configuration for the AMD Kria KV260 R5F running PX4 via Linux remoteproc.
#
# Derived from platforms/nuttx/NuttX/nuttx/boards/arm/zynqr5/kria-kv260/configs/nsh/defconfig
# with additions required by the PX4 platform layer.
#
CONFIG_ARCH="arm"
CONFIG_ARCH_BOARD_CUSTOM=y
CONFIG_ARCH_BOARD_CUSTOM_DIR="../../../../boards/amd/kria-kv260/nuttx-config"
CONFIG_ARCH_BOARD_CUSTOM_DIR_RELPATH=y
CONFIG_ARCH_BOARD_CUSTOM_NAME="px4"
CONFIG_ARCH_CHIP="zynqr5"
CONFIG_ARCH_CHIP_ZYNQR5=y
CONFIG_ARCH_INTERRUPTSTACK=2048
CONFIG_ARCH_LOWVECTORS=y
CONFIG_ARCH_STACKDUMP=y
CONFIG_ARMV7R_TOOLCHAIN_GNU_EABI=y

# Board control — required by PX4's boardctl(BOARDIOC_INIT) call
CONFIG_BOARDCTL=y
CONFIG_BOARD_LATE_INITIALIZE=y
CONFIG_INIT_ENTRYPOINT="nsh_main"

# C++ support — PX4 modules are C++
CONFIG_HAVE_CXX=y
CONFIG_HAVE_CXXINITIALIZE=y

# NuttX shell and built-in app support
CONFIG_BUILTIN=y
CONFIG_NSH_LIBRARY=y
CONFIG_NSH_BUILTIN_APPS=y
CONFIG_NSH_NESTDEPTH=8

# PX4's rcS needs more than NuttX's defaults for both of these, and every one
# of the other 124 PX4 NuttX boards sets exactly these values.  Leaving them at
# the defaults (80 / 7) is not cosmetic -- it corrupts commands:
#
#   LINELEN=80: rc.serial's two `set MAV_ARGS "..."` lines are 88 and 99 chars.
#   fgets() cut them at 79, losing the closing quote, so MAV_ARGS was never set
#   and `mavlink start ${MAV_ARGS} -x` degenerated to `mavlink start -x`.  With
#   no -d, mavlink falls back to DEFAULT_DEVICE_NAME == "/dev/ttyS1"
#   (mavlink_main.h) -- which on this board is UART1, *Linux's own console*.  A
#   second mavlink instance then streamed telemetry into it and made Linux
#   unusable.  This stayed latent only for as long as rcS never got far enough
#   to source rc.serial.
#
#   MAXARGUMENTS=7: six rcS lines pass 9-10 tokens.  Overflow prints
#   "too many arguments" and then runs the *truncated* command anyway
#   (nsh_parse.c), including the line that reports a bad SYS_AUTOSTART.
CONFIG_NSH_LINELEN=128
CONFIG_NSH_MAXARGUMENTS=15
CONFIG_NSH_ARCHINIT=y
CONFIG_SYSTEM_NSH=y

# Line editor: readline(), not cle().
#
# nshlib/Kconfig defaults this choice to NSH_CLE when !DEFAULT_SMALL, so the
# EMACS-like editor was in use here by omission rather than by choice -- and its
# own help text says to pick it "only if you work with a terminal that supports
# [cursor position reporting]".  The only console on this board is the MAVLink
# shell over rpmsg, which is a pipe: cle() emits ESC[6n and waits for a cursor
# report that never comes, fails with EINVAL, and nsh_session() then loops
# reprinting the prompt forever without ever reading a command
# ("nsh: nsh_session: cle failed: 22").  readline() is line-oriented, probes
# nothing and redraws nothing, so it works over a pipe.  12 other PX4 boards
# make the same choice; only this one had been leaving it to the default.
CONFIG_NSH_READLINE=y

# Filesystem support needed by PX4 (ROMFS for init scripts, procfs for diagnostics)
CONFIG_FS_BINFS=y
CONFIG_FS_PROCFS=y
CONFIG_FS_PROCFS_REGISTER=y
CONFIG_FS_ROMFS=y
CONFIG_FS_CROMFS=y

# Mount the built-in ROMFS at /etc and run it at boot (rc.sysinit + rcS).
# Without this, nsh_main() never sources /etc/init.d/rcS — discovered
# 2026-07-21 while bringing up simulator_sih: the board booted and rpmsg
# worked fine, but no PX4 module (including rc.board_defaults) was ever
# actually started, because this was missing. Every other PX4 NuttX board
# in this tree sets this same CROMFS combination (see e.g.
# boards/matek/gnss-m9n-f4/nuttx-config/nsh/defconfig).
CONFIG_NSH_CROMFSETC=y
CONFIG_NSH_ROMFSETC=y
CONFIG_NSH_ROMFSSECTSIZE=128

# POSIX / scheduler features used by PX4 work queues and tasks
CONFIG_FDCLONE_STDIO=y
CONFIG_POSIX_TIMERS=y
CONFIG_PREALLOC_TIMERS=32
CONFIG_PRIORITY_INHERITANCE=y

# Per-task CPU accounting, feeding PX4's "top".  Without it there is no way to
# tell a task that is blocked from one that is spinning, and this board has no
# console other than the MAVLink shell, so guessing was the only alternative.
#
# Use PX4's mechanism (SCHED_INSTRUMENTATION + platforms/nuttx/src/px4/common/
# cpuload.cpp), as the other 124 NuttX boards do, and NOT NuttX's own
# SCHED_CPULOAD: that one makes <nuttx/clock.h> declare a "struct cpuload_s",
# which collides with the uORB topic of the same name and stops the build in
# msg/topics_sources/cpuload.cpp.  The two are alternatives, not layers.
CONFIG_SCHED_INSTRUMENTATION=y
CONFIG_SCHED_INSTRUMENTATION_EXTERNAL=y
CONFIG_SCHED_INSTRUMENTATION_SWITCH=y
CONFIG_SCHED_HPWORK=y

# Default signal actions (SIGSTOP/SIGTSTP/SIGCONT, SIGKILL/SIGTERM).  This
# board never set it while the other 197 PX4 NuttX boards do; the gap only
# surfaced now because SIG_DEFAULT is what makes <nuttx/sched.h> declare
# TSTATE_TASK_STOPPED, which print_load.cpp switches on unconditionally.
CONFIG_SIG_DEFAULT=y

# Must be 24 to match PX4's TaskStackInfo.msg, which declares
# "char[24] task_name"; modules/load_mon has a static_assert on exactly this and
# will not compile otherwise.  NuttX's own default is 31, and this board had been
# leaving it there -- 176 of PX4's NuttX boards set 24.  Task names longer than
# 23 characters are truncated, which none of PX4's are.
CONFIG_TASK_NAME_SIZE=24
CONFIG_SCHED_LPWORK=y
CONFIG_SCHED_WAITPID=y
CONFIG_SCHED_WORKQUEUE=y

# Memory
CONFIG_RAM_SIZE=0x200000
CONFIG_RAM_START=0x1ED00000

# Two heap regions (rproc_0_reserved grown 256 KB -> 2 MB on 2026-07-21):
#   Region 0: [g_idle_topstack, 0x1EEFFE00) ~1.79 MB — code/heap below vring gap
#   Region 1: [0x3EF00000,      0x3EFB8000) ~736 KB — rpu1 (2nd R5 core)
#             carveout; unused since only RPU0 is loaded.  NOT
#             [0x1ED48000, 0x1EE00000) — that range was (pre-2026-07-21) the
#             live rpu0vdev0buffer OpenAMP/rpmsg buffer pool; it has since
#             moved to [0x1EF08000, 0x1F008000) (see init.c).
# The vrings live at 0x1EF00000 (vring0, 16 KB) and 0x1EF04000 (vring1, 16 KB).
CONFIG_MM_REGIONS=2

# Stack sizes
# Idle task only executes up_idle() -> WFI; 2 KB is sufficient.
# AppBringUp kthread runs board_late_initialize -> zynqr5_rptun_initialize ->
# rptun_initialize (OpenAMP/virtio init chain).  Observed stack depth with
# CONFIG_DEBUG_NOOPT: ~25 KB.  64 KB gives 2.5x headroom for future growth.
CONFIG_IDLETHREAD_STACKSIZE=2048
CONFIG_BOARD_INITTHREAD_STACKSIZE=65536
CONFIG_INIT_STACKSIZE=16384
CONFIG_SYSTEM_NSH_STACKSIZE=8192

# Priority of the init task, i.e. nsh_main, i.e. the task that executes rcS.
#
# The NuttX default is 100, which assumes the startup script is the most
# important thing running.  It is not on this board: on a single Cortex-R5 core
# nsh_main at 100 could not resume between the commands of its own script,
# because simulator_sih was at 180 at the time (it has since moved to 88, below
# the flight stack -- see SIH_TASK_PRIORITY in sih.cpp).  Raising the *builtins'* priority alone (see
# PRIORITY_DEFAULT in cmake/px4_add_module.cmake) was measured NOT to be enough
# precisely because of this: the spawned command completes, but the shell that
# has to read the next line never gets scheduled again.
#
# 185 puts nsh_main above sih (180) and just below the builtins it spawns (190),
# so a foreground command still runs to completion ahead of the shell that is
# waitpid()-ing it, rather than round-robining against it across
# CONFIG_RR_INTERVAL (200 ms) slices.  Both stay below the rpmsg transport
# threads (mavlink RX 203 / TX 204, rptun 224).
CONFIG_INIT_PRIORITY=185

# Scheduler
CONFIG_RR_INTERVAL=200

# 1 kHz system tick (default is 10 000 us / 100 Hz).
#
# Everything that sleeps on this board is quantised to one tick, because
# clock_time2ticks() rounds *up*: nxsig_usleep(1000) on a 100 Hz tick does not
# sleep 1 ms, it sleeps until the next 10 ms boundary.  Two consequences that
# were both being paid before this was set:
#
#   - rptun's receive path polls the IPI with nxsig_usleep(1000) (see
#     ZYNQR5_RPTUN_POLL_USEC in drivers/rptun/rptun.c).  At a 100 Hz tick that
#     poll could not run faster than 100 Hz no matter what the constant said,
#     and an rpmsg ping RTT crosses the gate ~4 times -- measured 34.5 ms avg,
#     clustered at 39.8 ms, against 0.2 ms for the transport itself.
#   - hrt_absolute_time() is CLOCK_MONOTONIC-backed (platforms/nuttx/src/px4/
#     amd/zynqr5/hrt/hrt.c), so the whole PX4 timebase -- MAVLink timestamps,
#     work-queue deadlines, the sih 200 Hz loop, which a 100 Hz tick cannot
#     even express -- had 10 ms resolution.
#
# The TTC interval is derived from this value in zynqr5_timerisr.c, so no
# other change is needed: 6.25 MHz / 1 kHz = 6250 counts, comfortably inside
# the 32-bit TTC interval register.  Cost is 1000 timer ISRs/s on a 500 MHz
# R5F, well under 1% CPU.
CONFIG_USEC_PER_TICK=1000

# Debugging
CONFIG_DEBUG_FEATURES=y
CONFIG_DEBUG_SYMBOLS=y
CONFIG_EXPERIMENTAL=y

# Memory diagnostics.  Module startup here is non-deterministic (exported
# parameter count varies 317..682 across boots of an identical image), which
# points at a resource failure rather than a configuration gap.
#
# These previously hard-hung the board about a second into boot -- the system
# tick itself stopped, i.e. a spin with interrupts disabled.  Cause: the heap
# debug hooks log through merr() -> syslog, syslog fans out to every
# registered channel, and one of those channels (rpmsg syslog) allocates --
# so a recursive allocation happened under mm_lock() with interrupts off.
#
# They are enabled now because the RSC_TRACE ring gives syslog a sink that
# neither allocates nor needs the scheduler, and CONFIG_SYSLOG_RPMSG (the
# allocating one) has been turned off above.  See TRACE_DA in
# arch/arm/src/zynqr5/zynqr5_rsc.c.
# DEBUG_MM stays off: it found no heap errors, and its hooks log through a path
# that allocates while the heap lock is held with interrupts off, which used to
# hard-hang the board (see the SYSLOG note above).
# CONFIG_DEBUG_MM is not set
# CONFIG_DEBUG_MM_ERROR is not set

# STACK_COLORATION is on because print_load.cpp hard-#errors without it, so
# "top" cannot be built at all otherwise.  197 of PX4's NuttX boards set it.
# It also restores the stack high-water column that was previously measured
# once (nothing above 63%) and then lost when this was turned back off.
CONFIG_STACK_COLORATION=y

# Flat binary output for remoteproc ELF packaging
CONFIG_RAW_BINARY=y

# TTC timer (system tick)
# Dedicated counter for PX4's HRT: TTC1 counter 1, i.e. the SAME TTC as the
# system tick (counter 0) but a different counter within it.  Each counter has
# its own CLK_CTRL, CNT_CTRL, INT_STATUS and INT_ENABLE, so the two do not
# interfere; only the peripheral reference clock is shared.
#
# Sharing is deliberate.  TTC0 is Linux's (bound to ttc-pwm, exposing
# /sys/class/pwm/pwmchip0), so it is out.  TTC2 and TTC3 have no Linux driver
# bound and look free -- but TTC2 was tried first and its counter never
# incremented: hrt_absolute_time() returned a constant, mavlink sent one burst
# of 15 messages at t=0 and then went silent forever because no stream ever
# became due again.  Their reference clocks are evidently left gated in CRL_APB,
# and ungating them would mean read-modify-write programming of CRL_APB from the
# R5 -- which this board has already been power-cycled over once.  TTC1's clock
# is known-good because the system tick has been running on it for weeks.
#
# Prescaler 5 divides 100 MHz by 64 -> 1.5625 MHz, i.e. 0.64 us per count, and
# microseconds convert exactly as count * 16 / 25.  An exact 1 MHz is impossible
# because the TTC prescaler only divides by powers of two.
CONFIG_ZYNQR5_TTC_HRT=y
CONFIG_ZYNQR5_TTC_HRT_BASE=0xff120000
CONFIG_ZYNQR5_TTC_HRT_COUNTER=1
CONFIG_ZYNQR5_TTC_HRT_IRQ=72
CONFIG_ZYNQR5_TTC_HRT_PRESCALE_LOG2=5

CONFIG_ZYNQR5_TTC1=y
CONFIG_ZYNQR5_TTC_COUNTER0=y
CONFIG_ZYNQR5_TTC_FREQ=100000000

# RPmsg / rptun IPC (R5F ↔ A53 via virtio vrings + IPI)
CONFIG_OPENAMP=y
CONFIG_RPTUN=y
CONFIG_RPTUN_PING=y
CONFIG_RPTUN_STACKSIZE=16384
CONFIG_RPTUN_THREAD=y
CONFIG_ZYNQR5_RPTUN=y

# rpmsg-backed /dev/ttyRPMSG0 — second named endpoint on the same vdev/vring
# pair as "rpmsg-ping" above (VIRTIO_RPMSG_F_NS is already set in
# zynqr5_rsc.c, so no new resource-table entry is needed). Registered from
# board_app_initialize() via uart_rpmsg_init("a53", "RPMSG0", ...) — after
# rptun's own ping endpoint has already claimed 0x400 — carries MAVLink
# between the PX4 mavlink module and the A53/Linux side.
CONFIG_RPMSG_UART=y

# Third rpmsg endpoint: live syslog output to Linux, for visibility NuttX
# has never had on this board (no working physical console). Bypasses the
# VFS/uart_dev_s serial layer entirely (drivers/syslog/syslog_rpmsg.c has
# its own rpmsg_create_ept(), file_operations.open == NULL) — does not
# touch the unresolved uart_open()/uart_setup() crash. Patched to a fixed
# src address (0x420) since syslog_rpmsg_init() registers its
# device_created callback earlier in boot than rptun_dev_start() runs;
# left at RPMSG_ADDR_ANY it would win 0x400 away from "rpmsg-ping" — the
# same collision already hit and fixed once for CONFIG_RPMSG_UART above.
# (0x500, tried first, was itself wrong: the fixed-address bitmap only
# covers [0x400, 0x47F] — 128 slots from RPMSG_RESERVED_ADDRESSES — so
# anything at 0x480+ is unconditionally rejected with RPMSG_ERR_PARAM;
# also had to move the actual rpmsg_create_ept() call off the calling
# thread — see syslog_rpmsg_create_ept_worker() — since running it
# synchronously inside rptun_dev_start()'s locked device_created
# broadcast deadlocked (EDEADLK).)
# MAX_CHANNELS bumped from the Kconfig default of 1 since the default
# channel and this one now coexist. CHARDEV explicitly disabled: it
# defaults to y and tries to register_driver(CONFIG_SYSLOG_DEVPATH, ...)
# == "/dev/ttyS1" — already claimed by zynqr5_serial.c's arm_serialinit()
# for UART1. That register_driver() call fails, so syslog_rpmsg_init()
# returns early and never reaches rpmsg_register_callback() at all —
# "rpmsg-syslog" silently never gets created. We only need the remote
# (Linux) side reading via the auto-created rpmsg_char device, not a
# local NuttX-side chardev, so just disable it instead of picking a new
# unclaimed devpath.
# SYSLOG over rpmsg is DISABLED in favour of the RSC_TRACE ring (see
# TRACE_DA in arch/arm/src/zynqr5/zynqr5_rsc.c).  Two reasons:
#
#  - its write path allocates and needs the rptun thread scheduled, so it
#    cannot carry the output that matters most: heap debug (which fires from
#    inside the allocator's lock with interrupts off) or an assertion register
#    dump.  Leaving it registered would keep CONFIG_DEBUG_MM deadlocking even
#    with a safe sink present, because syslog fans out to every channel.
#  - it never had a Linux consumer.  The kernel has no rpmsg-syslog driver; a
#    patch was posted upstream in 2019 and never merged, so the endpoint was
#    only reachable by raw rpmsg_char from userspace, and it delivered 0 bytes
#    across a full boot every time it was measured.
# CONFIG_SYSLOG_RPMSG is not set
CONFIG_SYSLOG_MAX_CHANNELS=2

# Needed by the PX4 mavlink module's internal pipe() usage. Without it,
# libc's pipe() (libs/libc/unistd/lib_pipe.c) has an unresolved reference
# to nx_pipe() at link time.
CONFIG_PIPES=y

# Required for PX4's mavlink module: Mavlink::mavlink_open_uart() calls
# tcgetattr()/tcsetattr() right after open() and treats failure as a hard
# open failure (3 retries, then gives up entirely, never writing a byte).
# Without this, uart_ioctl()'s TCGETS/TCSETS cases (drivers/serial/serial.c)
# are compiled out entirely and any ioctl(TCGETS/TCSETS) on ANY NuttX
# serial device — real UART or the rpmsg-uart transport — fails ENOTTY.
# This is almost certainly why mavlink never produced a single byte on
# /dev/ttyRPMSG0 despite the transport itself working (rpmsg-ping 10/10).
CONFIG_SERIAL_TERMIOS=y

# UARTs
# UART0 (0xFF000000) is exclusively owned by the R5F — Linux's device tree
# marks /axi/serial@ff000000 status="disabled", confirmed on-board 2026-07-21.
# UART1 (0xFF010000) is Linux's own console (ttyPS1/serial1, status="okay") —
# it must never be the NuttX console, or both cores fight over the same
# CR/IER/IDR/ISR/FIFO registers.
# UART0 stays the console even though it is electrically dead (no MIO pin on
# this carrier).  PX4's diagnostic output is redirected to an rpmsg tty by fd
# rather than by owning /dev/console -- see the PX4LOG endpoint in src/init.c.
#
# An earlier version of this comment claimed a live rpmsg console caused a
# boot loop because nsh_session() returns on EOF and the init task is
# respawned.  Both halves were wrong: NuttX never respawns
# CONFIG_INIT_ENTRYPOINT, and with CONFIG_NSH_CLE=y nsh_session() cannot
# return on a read failure.  The loop was an artifact of the Linux-side reader
# replaying the tty's transmit ring.
CONFIG_ZYNQR5_UART0=y
CONFIG_ZYNQR5_UART0_CONSOLE=y
# UART1 is Linux's console (ttyPS1) and NuttX must never be able to reach it.
# Not registering it at all is the only robust guarantee: while /dev/ttyS1
# existed, any PX4 module that fell back to DEFAULT_DEVICE_NAME could open it
# and flood Linux's console -- which is exactly what happened once rcS got far
# enough to run rc.serial with a truncated MAV_ARGS.  With this unset,
# arm_serialinit() never creates /dev/ttyS1, so that fallback fails cleanly
# instead of taking the A53's console down with it.
#
# Nothing on this board needs it: UART0 remains the (electrically dead)
# /dev/console, and CONFIG_SYSLOG_DEVPATH's "/dev/ttyS1" is inert because
# CONFIG_SYSLOG_CHAR is not set.
# CONFIG_ZYNQR5_UART1 is not set
CONFIG_UART0_BAUD=115200
CONFIG_UART0_RXBUFSIZE=256
CONFIG_UART0_TXBUFSIZE=512
